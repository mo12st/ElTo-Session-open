{
  "name": "mono",
  "label": "Mono",
  "version": 2,
  "schema_version": 3,
  "id": "mono",
  "description": "Black and white brutalism: huge light type, concrete photography, no color at all. Palette estimated from the user concept art; artist refines.",
  "author": "mo12st",
  "license": "Proprietary (all rights reserved, mo12st)",
  "assetsLicense": "Proprietary (all rights reserved, mo12st)",
  "identity": {
    "story": "A gallery of black ink and white paper; nothing shouts.",
    "signature": "Huge light type over concrete photography"
  },
  "compatible": {
    "shell": "1",
    "tool": "3"
  },
  "defaults": {
    "wallpaper": "assets/wallpapers/main.jpg",
    "dock": "island",
    "notch": "clock",
    "notchMode": "hidden",
    "notchRespectFullscreen": true,
    "sounds": false
  },
  "colors": {
    "surface": "#f6f6f6",
    "surfaceAlt": "#eaeaea",
    "ink": "#151514",
    "inkSoft": "#5a5959",
    "pitch": "#151514",
    "fog": "#d4d4d4",
    "line": "#c8c8c8",
    "fade": "#a8a7a6"
  },
  "roles": {
    "surface": "surface",
    "surfaceAlt": "surfaceAlt",
    "text": "ink",
    "textMuted": "inkSoft",
    "accent": "pitch",
    "selection": "fog",
    "divider": "line",
    "disabled": "fade"
  },
  "shape": {
    "radiusWindow": 0,
    "radiusCard": 0,
    "radiusPill": 0,
    "shadowAlpha": 0.28,
    "shadowBlur": 24,
    "shadowOffsetY": 12,
    "paperGrain": 0.0,
    "folderArt": "outline",
    "snail": "outline",
    "iconArt": "thin",
    "cardArt": "plain",
    "pageLayout": "columns",
    "folderView": "names"
  },
  "fonts": {
    "serif": "Inter",
    "serifItalic": "Inter Italic",
    "sans": "Inter",
    "mono": "IBM Plex Mono"
  },
  "icons": {
    "set": "lucide",
    "strokeWidth": 2,
    "size": 24,
    "systemTheme": "breeze"
  },
  "options": {
    "dock": "island",
    "notch": "clock",
    "wallpaper": "assets/wallpaper.jpg",
    "motion": "soft",
    "wallpapers": [
      {
        "path": "assets/wallpapers/main.jpg",
        "label": "Concrete"
      }
    ]
  },
  "dock": {
    "launcherMark": "logo",
    "launcherLogo": "assets/launcher.png"
  },
  "sounds": {
    "enabled": false,
    "events": {
      "session-start": "assets/sounds/session-start.wav",
      "notification": "assets/sounds/notification.wav",
      "drawer-open": "assets/sounds/drawer-open.wav",
      "lock": "assets/sounds/lock.wav",
      "unlock": "assets/sounds/unlock.wav"
    }
  },
  "layout": {
    "bar": "top-bar",
    "rail": "none",
    "launcher": "drawer",
    "windowControls": "right",
    "motionProfile": "soft"
  },
  "kde": {
    "colorscheme": {
      "generate": true,
      "schemeName": "ElTo Mono"
    }
  },
  "kvantum": {
    "enabled": false,
    "template": "elto-default"
  },
  "cursor": {
    "theme": "breeze_cursors",
    "size": 24
  },
  "aurorae": {
    "template": "ElToClassic",
    "frame": "surfaceAlt",
    "frameInactive": "divider",
    "title": "text"
  },
  "sddm": {
    "theme": "elto-classic",
    "layout": "split",
    "background": "assets/greeter-background.jpg",
    "backgroundColor": "surface",
    "accentColor": "accent"
  },
  "lock": {},
  "plymouth": {
    "enabled": false,
    "background": "assets/boot-background.jpg",
    "backgroundColor": "pitch",
    "snail": "assets/snail.png"
  },
  "grub": {
    "enabled": false,
    "background": "assets/boot-background.jpg",
    "font": "Inter",
    "itemColor": "text",
    "selectedColor": "selection",
    "selectedBackground": "surfaceAlt"
  },
  "assets": [
    {
      "path": "assets/wallpapers/main.jpg",
      "kind": "wallpaper",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/greeter-background.jpg",
      "kind": "greeter",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/boot-background.jpg",
      "kind": "boot",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/snail.png",
      "kind": "boot",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/sounds/session-start.wav",
      "kind": "sound",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/sounds/notification.wav",
      "kind": "sound",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/sounds/drawer-open.wav",
      "kind": "sound",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/sounds/lock.wav",
      "kind": "sound",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/sounds/unlock.wav",
      "kind": "sound",
      "license": "Proprietary (all rights reserved, mo12st)"
    }
  ]
}
