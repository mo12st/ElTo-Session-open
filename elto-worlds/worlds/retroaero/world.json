{
  "name": "retroaero",
  "label": "Retro Aero Pearl",
  "version": 2,
  "description": "Pearlescent space-age: glossy capsules, bubble wallpaper, sunset-pink accents, close button left. Palette estimated from the user concept art; artist refines.",
  "author": "mo12st",
  "license": "Proprietary (all rights reserved, mo12st)",
  "assetsLicense": "Proprietary (all rights reserved, mo12st)",
  "colors": {
    "surface": "#f4fbfd",
    "surfaceAlt": "#dff2f9",
    "ink": "#103250",
    "inkSoft": "#2c4c66",
    "blush": "#ee9fb8",
    "aqua": "#9ee5f9",
    "line": "#b8dde8",
    "fade": "#8fb0bc"
  },
  "roles": {
    "surface": "surface",
    "surfaceAlt": "surfaceAlt",
    "text": "ink",
    "textMuted": "inkSoft",
    "accent": "blush",
    "selection": "aqua",
    "divider": "line",
    "disabled": "fade"
  },
  "shape": {
    "radiusWindow": 24,
    "radiusCard": 16,
    "radiusPill": 999,
    "shadowAlpha": 0.28,
    "shadowBlur": 24,
    "shadowOffsetY": 12,
    "paperGrain": 0.0
  },
  "fonts": {
    "serif": "Quicksand",
    "serifItalic": "Quicksand",
    "sans": "Quicksand",
    "mono": "DejaVu Sans Mono"
  },
  "icons": {
    "set": "lucide",
    "strokeWidth": 2,
    "size": 24,
    "systemTheme": "breeze"
  },
  "options": {
    "dock": "island",
    "notch": "clock",
    "wallpaper": "assets/wallpaper.jpg",
    "motion": "soft"
  },
  "layout": {
    "bar": "bottom-console",
    "rail": "none",
    "launcher": "capsules",
    "windowControls": "close-left",
    "motionProfile": "glossy-pulse"
  },
  "kde": {
    "colorscheme": {
      "generate": true,
      "schemeName": "ElTo Retro Aero Pearl"
    }
  },
  "kvantum": {
    "enabled": false,
    "template": "elto-default"
  },
  "cursor": {
    "theme": "breeze_cursors",
    "size": 24
  },
  "aurorae": {
    "template": "ElToClassic",
    "frame": "surfaceAlt",
    "frameInactive": "divider",
    "title": "text"
  },
  "sddm": {
    "theme": "elto-classic",
    "layout": "pill-center",
    "background": "assets/greeter-background.jpg",
    "backgroundColor": "surface",
    "accentColor": "accent"
  },
  "lock": {},
  "plymouth": {
    "enabled": false,
    "background": "assets/boot-background.jpg",
    "backgroundColor": "aqua",
    "snail": "assets/snail.png"
  },
  "grub": {
    "enabled": false,
    "background": "assets/boot-background.jpg",
    "font": "Quicksand",
    "itemColor": "text",
    "selectedColor": "selection",
    "selectedBackground": "surfaceAlt"
  }
}