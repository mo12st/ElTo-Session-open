{
  "name": "y2k",
  "label": "Y2K Signal",
  "version": 2,
  "description": "Chrome and deep navy: signal-green accents, command index, fast linear motion. Palette estimated from the user concept art; artist refines.",
  "author": "mo12st",
  "license": "Proprietary (all rights reserved, mo12st)",
  "assetsLicense": "Proprietary (all rights reserved, mo12st)",
  "colors": {
    "surface": "#0e102e",
    "surfaceAlt": "#1f2357",
    "ink": "#e2e6ff",
    "inkSoft": "#8c96d0",
    "lime": "#b8e62e",
    "indigo": "#292c93",
    "line": "#2c3070",
    "fade": "#4a4e80"
  },
  "roles": {
    "surface": "surface",
    "surfaceAlt": "surfaceAlt",
    "text": "ink",
    "textMuted": "inkSoft",
    "accent": "lime",
    "selection": "indigo",
    "divider": "line",
    "disabled": "fade"
  },
  "shape": {
    "radiusWindow": 10,
    "radiusCard": 2,
    "radiusPill": 999,
    "shadowAlpha": 0.28,
    "shadowBlur": 24,
    "shadowOffsetY": 12,
    "paperGrain": 0.0
  },
  "fonts": {
    "serif": "Exo 2",
    "serifItalic": "Exo 2 Italic",
    "sans": "Exo 2",
    "mono": "IBM Plex Mono"
  },
  "icons": {
    "set": "lucide",
    "strokeWidth": 2,
    "size": 24,
    "systemTheme": "breeze"
  },
  "options": {
    "dock": "island",
    "notch": "clock",
    "wallpaper": "assets/wallpaper.jpg",
    "motion": "soft"
  },
  "layout": {
    "bar": "bottom-tasks",
    "rail": "right",
    "launcher": "keyboard-index",
    "windowControls": "left-close-right",
    "motionProfile": "linear"
  },
  "kde": {
    "colorscheme": {
      "generate": true,
      "schemeName": "ElTo Y2K Signal"
    }
  },
  "kvantum": {
    "enabled": false,
    "template": "elto-default"
  },
  "cursor": {
    "theme": "breeze_cursors",
    "size": 24
  },
  "aurorae": {
    "template": "ElToClassic",
    "frame": "surfaceAlt",
    "frameInactive": "divider",
    "title": "text"
  },
  "sddm": {
    "theme": "elto-classic",
    "layout": "terminal",
    "background": "assets/greeter-background.jpg",
    "backgroundColor": "surface",
    "accentColor": "accent"
  },
  "lock": {},
  "plymouth": {
    "enabled": false,
    "background": "assets/boot-background.jpg",
    "backgroundColor": "surface",
    "snail": "assets/snail.png"
  },
  "grub": {
    "enabled": false,
    "background": "assets/boot-background.jpg",
    "font": "Exo 2",
    "itemColor": "text",
    "selectedColor": "selection",
    "selectedBackground": "surfaceAlt"
  }
}