{
  "name": "aero",
  "label": "Aero Habitat",
  "version": 2,
  "schema_version": 3,
  "id": "aero",
  "description": "Glass panels over a bright ocean-habitat wallpaper; calm, airy, translucent. Palette estimated from the user concept art; artist refines.",
  "author": "mo12st",
  "license": "Proprietary (all rights reserved, mo12st)",
  "assetsLicense": "Proprietary (all rights reserved, mo12st)",
  "identity": {
    "story": "A bright habitat over the ocean; your workspace floats in glass.",
    "signature": "The ocean arch wallpaper and frosted panels"
  },
  "compatible": {
    "shell": "1",
    "tool": "3"
  },
  "defaults": {
    "wallpaper": "assets/wallpapers/main.jpg",
    "dock": "island",
    "notch": "clock",
    "notchMode": "auto-hide",
    "notchAutoHideMs": 400,
    "notchRespectFullscreen": true,
    "sounds": true
  },
  "colors": {
    "surface": "#eaf4f6",
    "surfaceAlt": "#d5e4df",
    "ink": "#052f59",
    "inkSoft": "#22668f",
    "teal": "#2aa5b8",
    "mist": "#a5d2e0",
    "line": "#c4d8dc",
    "fade": "#8aa5ae"
  },
  "roles": {
    "surface": "surface",
    "surfaceAlt": "surfaceAlt",
    "text": "ink",
    "textMuted": "inkSoft",
    "accent": "teal",
    "selection": "mist",
    "divider": "line",
    "disabled": "fade"
  },
  "shape": {
    "radiusWindow": 22,
    "radiusCard": 14,
    "radiusPill": 999,
    "shadowAlpha": 0.28,
    "shadowBlur": 24,
    "shadowOffsetY": 12,
    "paperGrain": 0.0,
    "glass": true,
    "surfaceAlpha": 0.72,
    "folderArt": "glass",
    "snail": "glass"
  },
  "fonts": {
    "serif": "Noto Serif Display",
    "serifItalic": "Noto Serif Display Italic",
    "sans": "Noto Sans",
    "mono": "DejaVu Sans Mono"
  },
  "icons": {
    "set": "lucide",
    "strokeWidth": 2,
    "size": 24,
    "systemTheme": "breeze"
  },
  "options": {
    "dock": "island",
    "notch": "clock",
    "wallpaper": "assets/wallpaper.jpg",
    "motion": "soft",
    "wallpapers": [
      {
        "path": "assets/wallpapers/main.jpg",
        "label": "Ocean arch"
      }
    ]
  },
  "sounds": {
    "enabled": true,
    "events": {
      "session-start": "assets/sounds/session-start.wav",
      "notification": "assets/sounds/notification.wav",
      "drawer-open": "assets/sounds/drawer-open.wav",
      "lock": "assets/sounds/lock.wav",
      "unlock": "assets/sounds/unlock.wav"
    }
  },
  "layout": {
    "bar": "bottom-tasks",
    "rail": "left",
    "launcher": "drawer",
    "windowControls": "menu-left-close-right",
    "motionProfile": "dissolve"
  },
  "kde": {
    "colorscheme": {
      "generate": true,
      "schemeName": "ElTo Aero Habitat"
    }
  },
  "kvantum": {
    "enabled": false,
    "template": "elto-default"
  },
  "cursor": {
    "theme": "breeze_cursors",
    "size": 24
  },
  "aurorae": {
    "template": "ElToClassic",
    "frame": "surfaceAlt",
    "frameInactive": "divider",
    "title": "text"
  },
  "sddm": {
    "theme": "elto-classic",
    "layout": "card-center",
    "background": "assets/greeter-background.jpg",
    "backgroundColor": "surface",
    "accentColor": "accent"
  },
  "lock": {},
  "plymouth": {
    "enabled": false,
    "background": "assets/boot-background.jpg",
    "backgroundColor": "surfaceAlt",
    "snail": "assets/snail.png"
  },
  "grub": {
    "enabled": false,
    "background": "assets/boot-background.jpg",
    "font": "Noto Sans",
    "itemColor": "text",
    "selectedColor": "selection",
    "selectedBackground": "surfaceAlt"
  },
  "assets": [
    {
      "path": "assets/wallpapers/main.jpg",
      "kind": "wallpaper",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/greeter-background.jpg",
      "kind": "greeter",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/boot-background.jpg",
      "kind": "boot",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/snail.png",
      "kind": "boot",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/sounds/session-start.wav",
      "kind": "sound",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/sounds/notification.wav",
      "kind": "sound",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/sounds/drawer-open.wav",
      "kind": "sound",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/sounds/lock.wav",
      "kind": "sound",
      "license": "Proprietary (all rights reserved, mo12st)"
    },
    {
      "path": "assets/sounds/unlock.wav",
      "kind": "sound",
      "license": "Proprietary (all rights reserved, mo12st)"
    }
  ]
}
